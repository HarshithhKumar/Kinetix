# Kinetix backend environment variables
# Copy to backend/.env and adjust as needed. Do not commit .env files.

# Paths (optional — defaults resolve from project root)
# KINETIX_MODEL_PATH=
# KINETIX_SCALER_PATH=
# KINETIX_DATA_DIR=

# CORS — comma-separated frontend origins
# KINETIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional regex for LAN/mobile dev origins (set to "none" to disable)
# KINETIX_CORS_ORIGIN_REGEX=

# Used by backend/test_api.py integration script
# KINETIX_API_URL=http://localhost:8000
