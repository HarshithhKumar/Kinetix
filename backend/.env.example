# Kinetix backend environment variables
# Copy to backend/.env and adjust as needed. Do not commit .env files.

# Paths (optional — defaults resolve from project root)
# KINETIX_MODEL_PATH=
# KINETIX_SCALER_PATH=
# KINETIX_DATA_DIR=

# CORS — comma-separated frontend origins (set production frontend URL on Render)
# KINETIX_CORS_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com

# Disable LAN regex in production (Docker sets this automatically)
# KINETIX_CORS_ORIGIN_REGEX=none

# Render injects PORT at runtime; start.sh uses 0.0.0.0:$PORT
# PORT=8000

# Used by backend/test_api.py integration script
# KINETIX_API_URL=http://localhost:8000
